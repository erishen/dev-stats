# 复制本文件为 .env 并填入你的配置（.env 已被 .gitignore 排除，不会入库）
# cp .env.example .env

# --- GitHub 认证（任选其一即可，优先级：--token > GITHUB_TOKEN/GH_TOKEN > gh CLI）---
# 已登录 gh CLI 时可不填，工具自动复用 gh auth token
GITHUB_TOKEN=
GH_TOKEN=

# --- 内容平台（掘金查询已支持）---
# 掘金：个人主页 URL 里的数字串，如 https://juejin.cn/user/123456789012/posts
# JUEJIN_USER_ID=

# 掘金：wordpress-tools 掘金文章目录（扫描 frontmatter 的 wp_id，dev-stats juejin 用）
# JUEJIN_ARTICLES_DIR=./path/to/wordpress-tools/articles/juejin

# --- 思否（segmentfault）：本地个人使用功能，默认禁用，公开部署请勿启用 ---
# SEGMENTFAULT_ENABLED=true
# SEGMENTFAULT_ARTICLES_DIR=./path/to/wordpress-tools/articles/segmentfault
